{
	"instance_min_count": 1,
	"instance_max_count": 4,
	"scaling_rules": [
		{
			"metric_type": "cpu",
			"threshold": 3,
			"operator": ">",
			"cool_down_secs": 60,
			"adjustment": "+1"
		},
		{
			"metric_type": "memoryused",
			"threshold": 30,
			"operator": "<",
			"cool_down_secs": 120,
			"adjustment": "-1"
		}
	]
}