{
  "_version": "1.86.0",
  "sap.app": {
    "id": "vehicleui5",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:basic",
      "version": "1.31.1",
      "toolsId": "4b723768-bec6-4f63-b33b-91077fcd49e3"
    },
    "dataSources": {
      "mainService": {
        "uri": "/odata/v4/vehicle/",
        "type": "OData",
        "settings": {
          "annotations": [],
          "localUri": "localService/mainService/metadata.xml",
          "odataVersion": "4.0"
        }
      }
    },
    "crossNavigation": {
      "inbounds": {
        "vehicleui5-display": {
          "semanticObject": "vehicleui5",
          "action": "display",
          "title": "{{vehicleui5-display.flpTitle}}",
          "signature": {
            "parameters": {},
            "additionalParameters": "allowed"
          }
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": false,
    "dependencies": {
      "minUI5Version": "1.151.0",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "vehicleui5.i18n.i18n"
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      }
    },
    "resources": {
      "css": [
        {
          "uri": "css/style.css"
        }
      ]
    },
    "routing": {
      "config": {
        "routerClass": "sap.m.routing.Router",
        "controlAggregation": "pages",
        "controlId": "app",
        "transition": "slide",
        "type": "View",
        "viewType": "XML",
        "path": "vehicleui5.view",
        "async": true,
        "viewPath": "vehicleui5.view"
      },
      "routes": [
        {
          "name": "Routeoverview",
          "pattern": ":?query:",
          "target": [
            "Targetoverview"
          ]
        },
        {
          "name": "AddVehicleView",
          "pattern": "addvehicle",
          "target": "AddVehicle"
        },
        {
          "name": "Dashboard",
          "pattern": "dashboard",
          "target":"Dashboard"
        }
      ],
      "targets": {
        "Targetoverview": {
          "id": "overview",
          "name": "overview"
        },
        "AddVehicle": {
          "id": "addVehicle",
          "name": "AddVehicle"
        },
        "Dashboard":{
          "id": "dashboard",
          "name": "Dashboard"
        }
      }
    },
    "rootView": {
      "viewName": "vehicleui5.view.App",
      "type": "XML",
      "id": "App",
      "async": true
    }
  },
  "sap.cloud": {
    "public": true,
    "service": "vehicleui5"
  }
}