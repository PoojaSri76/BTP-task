<mvc:View
xmlns="sap.m"
xmlns:mvc="sap.ui.core.mvc"
xmlns:l="sap.ui.layout"
xmlns:f="sap.ui.layout.form"
xmlns:core="sap.ui.core"
controllerName="ui5task.controller.Login">
    <Page>
    <customHeader>
    <Toolbar>
        <Image src="images/logo.avif" height="30px" width="150px"/>
    </Toolbar>
    </customHeader>
    <content>
    <l:Grid defaultSpan=" L6 M6 S12" class="sapUiSmallMargin">
        <Image src="images/re1.jpg" height="500px" width="550px"/>
        <f:SimpleForm id="loginForm" title="Register" >
            <f:content>
                <Label text="E-mail"/>
                <Input type="Email" placeholder="Enter Email" required="true"/>
                <Label text="First name"/>
                <Input type="Text" placeholder="Enter First Name" required="true"/>
                <Label text="Last name"/>
                <Input type="Text" placeholder="Enter Last Name" required="true"/>
                <Label text="Mobile Number"/>
                <Input type="Number" placeholder="Enter Mobile Number" required="true"/>
                <Label text="Date of Birth"/>
                <Input type="Date" required="true"/>
                <Label text="State"/>
                <Select items="{location>/states}">
                    <core:Item key="{location>code}" text="{location>name}"/>
                </Select>
                <Label text="City"/>
                <Select items="{location>/cities}">
                    <core:ListItem key="{location>code}" text="{location>name}"/>
                </Select>
                <Label text="Password"/>
                <Input type="Password" placeholder="Enter Password" required="true"/>
                <Label text="Confirm Password"/>
                <Input type="Password" placeholder="Re-enter Password" required="true"/>
            </f:content>
            <Button text="Submit" type="Emphasized" press="onSubmit"></Button>
        </f:SimpleForm>
    </l:Grid>
    </content>
    </Page>
</mvc:View>