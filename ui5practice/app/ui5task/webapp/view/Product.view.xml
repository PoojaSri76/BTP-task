<mvc:View xmlns:f="sap.f"
xmlns:mvc="sap.ui.core.mvc"
xmlns="sap.m"
xmlns:core="sap.ui.core"
xmlns:grid="sap.ui.layout.cssgrid"
controllerName="ui5task.controller.Product">
    <!-- <SearchField width="50%"/> -->
    <f:GridList 
    headerText="{i18n>productListTitle}"
    items="{product>/products}">
        <f:customLayout>
            <grid:GridBoxLayout boxMinWidth="220px"/>
        </f:customLayout>
        <f:GridListItem highlight="{= ${product>stock} > 10 ? 'Success' : 'Error' }">
            <VBox height="100%" class="sapUiSmallMargin">
                <HBox justifyContent="SpaceBetween">
                    <RatingIndicator maxValue="5" 
                    class="sapUiSmallMarginBottom" 
                    value="{product>rating}" 
                    displayOnly="true"
                    iconSize="12px">
                    </RatingIndicator>
                    <Button icon="sap-icon://hint" press="onProductPress" type="Transparent"/>
                </HBox>
                <Image src="{product>image}" width="100%" height="100px"/>
                <Title text="{product>name}"/>
                <Label text="Brand: {product>brand}"/>
                <Text text="{product>price} INR"/>
                <ObjectNumber number="{product>stock} stocks Available" state="{= ${product>stock} > 10? 'None' : 'Error'}"
                visible="true"/>
                <HBox justifyContent="SpaceAround" class="sapUiSmallMarginTop">
                    <!-- <Button icon="sap-icon://less" press="onRemoveFromCart" id="removeCart" enabled="false"></Button> -->
                    <Button icon="sap-icon://cart-3" text="Add" press="onAddToCart" id="addToCart"></Button>
                </HBox>
            </VBox>
            
        </f:GridListItem>
    </f:GridList>
</mvc:View>