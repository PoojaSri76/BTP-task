<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:f="sap.ui.layout.form">

    <Dialog
        id="summaryDialog"
        title="Vehicle Summary"
        contentWidth="400px">

        <List items="{summary>/items}">
            <StandardListItem
                title="{summary>state}"
                info="{summary>count}"
            />
        </List>

        <beginButton>
            <Button
                text="Close"
                press=".onCloseSummary"/>
        </beginButton>

    </Dialog>

</core:FragmentDefinition>