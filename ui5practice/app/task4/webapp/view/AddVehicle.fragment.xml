<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:f="sap.ui.layout.form">

    <Dialog
        id="addVehicleDialog"
        title="Add Vehicle"
        contentWidth="500px">

        <content>
            <f:SimpleForm
                editable="true"
                layout="ResponsiveGridLayout"
                class="sapUiResponsiveMargin">

                <Label text="Vehicle ID" required="true"/>
                <Input
                    id="vehicleIdInput"
                    placeholder="Enter Vehicle ID"
                    width="400px"/>

                <Label text="Name" required="true"/>
                <Input
                    id="vehicleNameInput"
                    placeholder="Enter Vehicle Name"
                    width="400px"/>

                <Label text="State" required="true"/>
                <Input
                    id="vehicleStateInput"
                    placeholder="Enter State"
                    width="400px"/>

                <Label text="New Price" required="true"/>
                <Input
                    id="vehiclePriceInput"
                    type="Number"
                    placeholder="Enter New Price"
                    width="400px"/>

            </f:SimpleForm>
        </content>

        <beginButton>
            <Button
                text="Save"
                type="Emphasized"
                press=".onSaveVehicle"/>
        </beginButton>

        <endButton>
            <Button
                text="Cancel"
                press=".onCancelAddVehicle"/>
        </endButton>

    </Dialog>

</core:FragmentDefinition>