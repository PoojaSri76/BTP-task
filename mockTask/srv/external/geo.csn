    },
    "city": {
     "type": "cds.String"
    },
    "county": {
     "type": "cds.String"
    },
    "state": {
     "type": "cds.String"
    },
    "country": {
     "type": "cds.String"
    },
    "postalcode": {
     "type": "cds.String"
    }
   },
   "returns": {
    "type": "geo.return_GeocodeService_getStructuredLocation"
   }
  },
  "geo.return_GeocodeService_getLocation": {
   "kind": "type",
